APP_NAME="UPA Perkasa Unmul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

LOG_CHANNEL=daily
LOG_LEVEL=debug

# Database lama dipakai apa adanya. JANGAN jalankan `php artisan migrate` di database ini.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_perkasa
DB_USERNAME=root
DB_PASSWORD=

# Database kedua (tracerstudy.talumni_unmul)
DB_DATABASE_2=tracerstudy
# DB_HOST_2=
# DB_USERNAME_2=
# DB_PASSWORD_2=

# Tanpa tabel tambahan: sesi, cache, dan antrean memakai file/sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Folder upload lama ada di storage/app/legacy (isi dari backup, lalu `php artisan storage:link`).
# Selama pengembangan boleh diarahkan ke server lama agar gambar tampil tanpa menyalin file:
# LEGACY_ASSET_URL=https://perkasa.unmul.ac.id/storages
LEGACY_ASSET_URL=

# Menu Tracer Study sementara diarahkan ke aplikasi lama sampai modul tracer dipindah
LEGACY_TRACER_URL=https://perkasa.unmul.ac.id/perkasa2/tracer-study

# Login mahasiswa lewat API OSM Unmul (minta ke pengelola aplikasi lama; jangan ditulis di kode)
OSM_BASE_URL=https://osm.unmul.ac.id
OSM_API_KEY=
OSM_USERNAME=
OSM_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="uptperkasa.mulawarman@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
